{
  "info": {
    "_postman_id": "booksales-api-complete",
    "name": "Booksales API - Complete Test Suite",
    "description": "Collection untuk menguji endpoint read publik dan memastikan endpoint mutasi Books, Authors, dan Genres menolak request tanpa autentikasi admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "author_id",
      "value": "1"
    },
    {
      "key": "genre_id",
      "value": "1"
    },
    {
      "key": "book_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authors",
      "item": [
        {
          "name": "01 - List Authors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/authors",
            "description": "Mengambil semua author beserta relasi books."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response memiliki data author', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02 - Search Authors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/authors?search=Tere",
            "description": "Mencari author berdasarkan nama atau bio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Hasil pencarian mengandung Tere Liye', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.some(function (author) { return author.name === 'Tere Liye'; })).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "03 - Get Author Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/authors/{{author_id}}",
            "description": "Mengambil detail author berdasarkan ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Data author memiliki field utama', function () {",
                  "    pm.expect(pm.response.json().data).to.have.property('name');",
                  "    pm.expect(pm.response.json().data).to.have.property('books');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "04 - Create Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Author\",\n  \"photo\": \"postman-test-author.jpg\",\n  \"bio\": \"Author yang dibuat untuk pengujian API.\"\n}"
            },
            "url": "{{base_url}}/authors",
            "description": "Membuat author baru dan menyimpan ID-nya."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mutasi tanpa autentikasi ditolak', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "05 - Update Author",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Updated Author\",\n  \"bio\": \"Bio author yang telah diperbarui.\"\n}"
            },
            "url": "{{base_url}}/authors/{{created_author_id}}",
            "description": "Memperbarui author yang dibuat oleh request sebelumnya."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mutasi tanpa autentikasi ditolak', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "06 - Delete Author",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/authors/{{created_author_id}}",
            "description": "Menghapus author hasil pengujian."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mutasi tanpa autentikasi ditolak', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "07 - Validation Error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": "{{base_url}}/authors",
            "description": "Memastikan field name wajib divalidasi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validasi tidak dilewati tanpa autentikasi', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
